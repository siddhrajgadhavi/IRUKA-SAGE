# SAGE counselor — AIRouter is the primary provider.
# Keep this file private and never put keys in frontend code.
AIROUTER_API_KEY=your_airouter_key_here
AIROUTER_BASE_URL=https://api.airouter.in/v1
AIROUTER_MODEL=google/gemini-3.7-flash

# Optional direct OpenAI fallback for SAGE / legacy credential fallback.

# Gemini is the primary credential verification engine.

# Optional: set this if your Python executable is not named python3 on your system.
# PYTHON_BIN=python
